# =========================================================================
# IDE & System Files
# =========================================================================
# Ignore IntelliJ IDEA project files
.idea/
*.iws
*.iml
*.ipr
out/

# Ignore Eclipse project files
.metadata/
.classpath
.project
.settings/
*.launch

# Ignore NetBeans files
nbproject/private/
build/
nbbuild/
dist/
nbdist/

# OS generated files
.DS_Store
Thumbs.db

# =========================================================================
# Java & Build Tools (Applies to all microservice subfolders)
# =========================================================================
# Compiled class files
*.class

# Log files
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven build directory
**/target/

# Gradle build directory
**/.gradle/
**/build/

# =========================================================================
# Docker & Environments
# =========================================================================
# Ignore local environment variables / secrets
.env
.env.local

# Docker specific patterns if data directories are created locally
**/docker/data/


